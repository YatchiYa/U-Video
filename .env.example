# UGC Studio settings. Copy to .env and fill what you use. Real environment variables win over this file.
# Nothing is required to run fully local with the default open-source models, except HF_TOKEN to download them.
# Check the result any time with:  ugc providers   (and per project: ugc providers <project>)

# ---------------------------------------------------------------- where each capability runs
# Default: local. A project can override in project.yaml:  providers: {video: kling, image: openai}
UGC_IMAGE_PROVIDER=local        # local (FLUX.2 klein) | openai | gemini | huggingface
UGC_VIDEO_PROVIDER=local        # local (LTX-2.5) | veo | kling | seedance
UGC_VOICE_PROVIDER=auto         # auto (qwen/chatterbox/habibi by language) | elevenlabs | openai | gemini
UGC_MUSIC_PROVIDER=local        # local (ACE-Step 1.5) | elevenlabs
# Optional model per provider (empty = provider default shown in brackets)
UGC_IMAGE_MODEL=                # [openai: gpt-image-2.5-flare, gemini: gemini-3.1-flash-image, huggingface: black-forest-labs/FLUX.1-schnell]
UGC_VIDEO_MODEL=                # [veo: veo-3.1-generate-preview, kling: kling-3.0, seedance: dreamina-seedance-2-5-260628]
UGC_VOICE_MODEL=                # [elevenlabs: eleven_multilingual_v2, openai: gpt-4o-mini-tts, gemini: gemini-3.8-flash-tts]
UGC_MUSIC_MODEL=                # [elevenlabs: music_v2]

# ---------------------------------------------------------------- API keys (only for the providers you use)
HF_TOKEN=                       # Hugging Face: model downloads (accept the LTX-2.5 license) + huggingface provider
OPENAI_API_KEY=
GEMINI_API_KEY=                 # Google AI Studio key (Veo, Gemini image, Gemini TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # default ElevenLabs voice (or voice.voice_id in project.yaml)
KLING_API_KEY=                  # Kling developer console API key
KLING_BASE_URL=                 # default https://api-singapore.klingai.com
ARK_API_KEY=                    # Seedance via BytePlus ModelArk
ARK_BASE_URL=                   # default https://ark.ap-southeast.bytepluses.com/api/v3 (China: https://ark.cn-beijing.volces.com/api/v3)
UGC_HF_PROVIDER=hf-inference    # huggingface image route: hf-inference | fal-ai

# ---------------------------------------------------------------- Docker (docker compose only; host folders)
UGC_MODELS_HOST=./models        # model weights on the host
UGC_OUTPUTS_HOST=./outputs      # projects on the host
HF_CACHE_HOST=                  # e.g. /home/you/.cache/huggingface to reuse downloads (default: a Docker volume)
UGC_UID=1000                    # files written by the containers belong to this user (id -u)
UGC_GID=1000                    # (id -g)
UGC_API_PORT=8000
UGC_WEB_PORT=3000

# ---------------------------------------------------------------- local models (swap any open-source checkpoint)
UGC_MODELS=                     # weights folder [./models]
UGC_OUTPUTS=                    # projects folder [./outputs]
# LTX video (folder + file names inside it)
UGC_LTX_DIR=                    # [models/ltx-2.5]
UGC_LTX_REPO=                   # [Lightricks/LTX-2.5]  (used by `ugc models download`)
UGC_LTX_TRANSFORMER=            # [diffusion_models/ltx-2.5-22b-distilled-transformer-bf16.safetensors]
UGC_LTX_TEXT_ENCODER=           # [text_encoders/gemma4-12b-with-proj-ltx-2.5-bf16.safetensors]
UGC_LTX_VIDEO_VAE=              # [vae/ltx-2.5-video-vae-bf16.safetensors]
UGC_LTX_AUDIO_VAE=              # [vae/ltx-2.5-audio-vae-bf16.safetensors]
UGC_LTX_UPSAMPLER=              # [latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors]
UGC_LTX_QUANTIZATION=           # [fp8-cast] | none (full bf16, bigger GPU)
UGC_LTX_OFFLOAD=                # [cpu] (12 GB GPUs) | none
# Images
UGC_FLUX_DIR=                   # [models/flux2-klein-4b]
UGC_FLUX_REPO=                  # [black-forest-labs/FLUX.2-klein-4B]
UGC_FLUX_STEPS=                 # [4]
# (UGC_IMAGE_MODEL with the local provider = another FLUX.2 klein checkpoint: HF id or folder)
# Script writer, speech checks and judges
UGC_DIRECTOR_LLM=               # [Qwen/Qwen3-4B-Instruct-2507]
UGC_ASR_MODEL=                  # [openai/whisper-large-v3-turbo]
UGC_PHONEME_MODEL=              # [facebook/wav2vec2-xlsr-53-espeak-cv-ft]
UGC_CLIP_MODEL=                 # [openai/clip-vit-large-patch14]
UGC_DINO_MODEL=                 # [facebook/dinov2-base]
# Local narration (Qwen3-TTS; Chatterbox and Habibi use their fixed checkpoints)
UGC_TTS_DESIGN_MODEL=           # [Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign]
UGC_TTS_CLONE_MODEL=            # [Qwen/Qwen3-TTS-12Hz-1.7B-Base]
UGC_ACE_DIR=                    # [vendor/ACE-Step-1.5]
