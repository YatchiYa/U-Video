# UGC Studio settings. Copy to .env and fill what you use. Real environment variables win over this file.
# Nothing is required to run fully local with the default open-source models, except HF_TOKEN to download them.
# Check the result any time with:  ugc providers   (and per project: ugc providers <project>)
# Keep comments on their own lines: Docker Compose reads `KEY=   # note` as the value "# note".

# ---------------------------------------------------------------- where each capability runs
# Default: local. A project can override in project.yaml:  providers: {video: kling, image: openai}
# local (Qwen-Image-Edit / Z-Image / FLUX.2 klein, best per frame) | openai | gemini | huggingface
UGC_IMAGE_PROVIDER=local
# local (LTX-2.5) | veo | kling | seedance
UGC_VIDEO_PROVIDER=local
# auto (qwen/chatterbox/habibi by language) | elevenlabs | openai | gemini
UGC_VOICE_PROVIDER=auto
# local (ACE-Step 1.5) | elevenlabs
UGC_MUSIC_PROVIDER=local
# Optional model per provider (empty = provider default shown in brackets)
# [openai: gpt-image-2.5-flare, gemini: gemini-3.1-flash-image, huggingface: black-forest-labs/FLUX.1-schnell]
UGC_IMAGE_MODEL=
# [veo: veo-3.1-generate-preview, kling: kling-3.0, seedance: dreamina-seedance-2-5-260628]
UGC_VIDEO_MODEL=
# [elevenlabs: eleven_multilingual_v2, openai: gpt-4o-mini-tts, gemini: gemini-3.8-flash-tts]
UGC_VOICE_MODEL=
# [elevenlabs: music_v2]
UGC_MUSIC_MODEL=

# ---------------------------------------------------------------- API keys (only for the providers you use)
# Hugging Face: model downloads (accept the LTX-2.5 license) + huggingface provider
HF_TOKEN=
OPENAI_API_KEY=
# Google AI Studio key (Veo, Gemini image, Gemini TTS)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# default ElevenLabs voice (or voice.voice_id in project.yaml)
ELEVENLABS_VOICE_ID=
# Kling developer console API key
KLING_API_KEY=
# default https://api-singapore.klingai.com
KLING_BASE_URL=
# Seedance via BytePlus ModelArk
ARK_API_KEY=
# default https://ark.ap-southeast.bytepluses.com/api/v3 (China: https://ark.cn-beijing.volces.com/api/v3)
ARK_BASE_URL=
# huggingface image route: hf-inference | fal-ai
UGC_HF_PROVIDER=hf-inference

# ---------------------------------------------------------------- Docker (docker compose only; host folders)
# model weights on the host
UGC_MODELS_HOST=./models
# projects on the host
UGC_OUTPUTS_HOST=./outputs
# e.g. /home/you/.cache/huggingface to reuse downloads (default: a Docker volume)
HF_CACHE_HOST=
# files written by the containers belong to this user (id -u)
UGC_UID=1000
# (id -g)
UGC_GID=1000
UGC_API_PORT=8000
UGC_WEB_PORT=3000

# ---------------------------------------------------------------- local models (swap any open-source checkpoint)
# weights folder [./models]
UGC_MODELS=
# projects folder [./outputs]
UGC_OUTPUTS=
# LTX video (folder + file names inside it)
# [models/ltx-2.5]
UGC_LTX_DIR=
# [Lightricks/LTX-2.5]  (used by `ugc models download`)
UGC_LTX_REPO=
# [diffusion_models/ltx-2.5-22b-distilled-transformer-bf16.safetensors]
UGC_LTX_TRANSFORMER=
# [text_encoders/gemma4-12b-with-proj-ltx-2.5-bf16.safetensors]
UGC_LTX_TEXT_ENCODER=
# [vae/ltx-2.5-video-vae-bf16.safetensors]
UGC_LTX_VIDEO_VAE=
# [vae/ltx-2.5-audio-vae-bf16.safetensors]
UGC_LTX_AUDIO_VAE=
# [latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors]
UGC_LTX_UPSAMPLER=
# [fp8-cast] | none (full bf16, bigger GPU)
UGC_LTX_QUANTIZATION=
# [cpu] (12 GB GPUs) | none
UGC_LTX_OFFLOAD=
# Keyframes (local): best engine per frame, used automatically once downloaded (`ugc models download`)
# frames with references (identity): [qwen-edit if downloaded, else flux] | flux
UGC_KEYFRAME_EDIT=
# frames without references: [zimage if downloaded, else flux] | flux
UGC_KEYFRAME_T2I=
# a specific Qwen-Image-Edit-2511 GGUF file [unsloth Q4_K_M from the HF cache]
UGC_QWEN_EDIT_GGUF=
# [models/flux2-klein-4b]
UGC_FLUX_DIR=
# [black-forest-labs/FLUX.2-klein-4B]
UGC_FLUX_REPO=
# [4]
UGC_FLUX_STEPS=
# (UGC_IMAGE_MODEL with the local provider = another FLUX.2 klein checkpoint: HF id or folder)
# Script writer, speech checks and judges
# [Qwen/Qwen3.5-9B]  (e.g. google/gemma-4-12B-it)
UGC_DIRECTOR_LLM=
# [1] NF4 quantization (a 9B model in ~7 GB of VRAM) | 0
UGC_DIRECTOR_4BIT=
# [openai/whisper-large-v3-turbo]
UGC_ASR_MODEL=
# second opinion for Arabic speech checks [Qwen/Qwen3-ASR-1.7B-hf] | whisper (off)
UGC_ARABIC_ASR=
# [facebook/wav2vec2-xlsr-53-espeak-cv-ft]
UGC_PHONEME_MODEL=
# [openai/clip-vit-large-patch14]
UGC_CLIP_MODEL=
# [facebook/dinov2-base]
UGC_DINO_MODEL=
# Local narration (Qwen3-TTS; Chatterbox and Habibi use their fixed checkpoints)
# [Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign]
UGC_TTS_DESIGN_MODEL=
# [Qwen/Qwen3-TTS-12Hz-1.7B-Base]
UGC_TTS_CLONE_MODEL=
# [vendor/ACE-Step-1.5]
UGC_ACE_DIR=
# [acestep-v15-turbo] | acestep-v15-xl-turbo (XL: better audio, ~20 GB, int8 + offload)
UGC_ACE_CONFIG=
# [v3] Chatterbox Multilingual model | v2
UGC_CHATTERBOX_T3=
